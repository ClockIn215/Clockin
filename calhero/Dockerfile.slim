# Slim Dockerfile - LLM version only (no Tesseract needed)
# Smaller image size, faster builds
# Usage:
#   docker build -f Dockerfile.slim -t calhero-llm .

FROM python:3.11-slim

WORKDIR /app

# Copy requirements (LLM only)
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY calendar_utils.py ./
COPY calhero.py ./

# Create directories
RUN mkdir -p screenshots screenshots/processed

# Run LLM version
CMD ["python", "calhero.py"]
